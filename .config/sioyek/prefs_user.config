should_launch_new_window 1

# Ratio of page width used by the fit_to_page_width_ratio command.
# 0.9 = slightly less than full width (leaves a small side margin).
fit_to_page_width_ratio 0.9

# Enable dark mode and fit-to-width on startup. startup_commands are chained
# with ';'. fit_to_page_width_ratio fits to the ratio set above (slightly
# less than full width) rather than the full page width.
startup_commands toggle_dark_mode;fit_to_page_width_ratio

# Dark mode appearance. dark_mode_contrast dims inverted whites; a value of
# 1.0 crushed the page to solid black, so use the commonly-recommended 0.7.
dark_mode_background_color    0.0 0.0 0.0
dark_mode_contrast            0.7
